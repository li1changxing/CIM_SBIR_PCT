import torch.nn.functional as F
def class_loss(query, key, tau=0.07):
        query = F.normalize(query, p=2, dim=1)
        key = F.normalize(key, p=2, dim=1)
        logits = torch.einsum('nc,ck->nk', [query, key.detach().T])
        logits /= tau
        return logits

