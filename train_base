    elif args.type == "ssf":
        model = vit_ssf()
    elif args.type == "LAE":
        model = vit_lae()
    elif args.type == "adapter":
        model = vit_adapter()
    elif args.type == "l2p" or args.type == "dual" or args.type == "coda":
        model = vit_pt_imnet(prompt_flag = args.type)
    elif args.type == "CLIP_AT":
  
        import clip
        clip_model, _ = clip.load('ViT-B/16', device="cuda")
        tokenizer = clip.tokenize
        
        prototype_txt = clip_model.encode_text(tokenizer(datasets.name).cuda()).detach()
        
        model = CLIP_AT(25*stage)
